# DISCORD_BOT_TOKEN=paste_after_creation
# DISCORD_CHANNEL_ID=123456789012345678
# Your own Discord account ID, not the bot's. Commands are refused for every other user.
# DISCORD_USER_ID=123456789012345678
# The server ID. Set it so slash commands register instantly instead of taking up to an
# hour to propagate as global commands.
# DISCORD_GUILD_ID=123456789012345678
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8888
# Only used if SEARCH_PROVIDER=brave:
# BRAVE_SEARCH_API_KEY=paste_after_creation
# Set LLM_PROVIDER=disabled to use deterministic extraction only, which is much faster.
LLM_PROVIDER=ollama
# Your own Ollama host. Usually a Tailscale address, which is why it lives here and has
# no default in code. A model of about 8B fits comfortably in 8GB of VRAM.
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_MODEL=aisingapore/Gemma-SEA-LION-v3-9B-IT:q4_k_m
# Optional second host, tried only when the first answers thinly or cannot be reached.
# Point this at a machine with more VRAM if you have one; leave blank if you do not.
OLLAMA_ESCALATION_URL=
OLLAMA_ESCALATION_MODEL=qwen2.5vl:7b
# Only used if LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=
KAGGLE_API_TOKEN=
PROXY_MODE=auto
DATABASE_URL=sqlite+aiosqlite:///data/akaton.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Optional extra protection when not relying solely on Tailscale ACLs:
# DASHBOARD_TOKEN=replace_with_a_long_random_value
DASHBOARD_AUTO_START=true
# This machine's Tailscale address. Find it with: tailscale ip -4
TAILSCALE_IP=100.100.100.100
# Required by compose.free.yaml; generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SEARXNG_SECRET=replace_with_generated_value
NOTIFICATIONS_ENABLED=false
LOG_LEVEL=INFO
# Optional dedicated Facebook login for the philhacks scraper. Leave blank and log
# in once in the headed Chrome window instead; the session is kept in
# data/.facebook-profile. If set, the scraper can pre-fill the login form.
# FACEBOOK_EMAIL=
# FACEBOOK_PASSWORD=
